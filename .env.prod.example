# ==============================================================================
# OutreachAI – Production Environment Variables
# Copy to .env.prod and fill in all values before deploying
# NEVER commit .env.prod to git
# ==============================================================================

# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain as configured in Caddyfile (no https://, no trailing slash)
DOMAIN=yourdomain.com

# ── Database (Postgres) ───────────────────────────────────────────────────────
POSTGRES_USER=outreach
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=outreachai
# DATABASE_URL is constructed automatically in docker-compose.prod.yml

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=OutreachAI
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Frontend (baked into Next.js build) ──────────────────────────────────────
# Must match your domain — used by next.config.js rewrites (server-side)
# This can be the internal Docker URL since it's a server-side rewrite
NEXT_PUBLIC_API_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=OutreachAI

# ── LLM – Anthropic (primary) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# ── LLM – OpenAI (fallback + embeddings) ─────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60
LLM_MONTHLY_BUDGET_USD=500.0

# ── Web Research ──────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
TAVILY_API_KEY=tvly-...
SERPAPI_KEY=

# ── Email – SendGrid ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=outreach@yourdomain.com
EMAIL_DEFAULT_FROM=outreach@yourdomain.com
EMAIL_DEFAULT_FROM_NAME=OutreachAI

# ── Email – Gmail IMAP (reply polling) ───────────────────────────────────────
# Use an App Password (not your regular password): myaccount.google.com/apppasswords
GMAIL_IMAP_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Google OAuth (optional per-user Gmail integration) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS (S3 storage + optional SES) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=outreachai-uploads
AWS_S3_REGION=us-east-1
AWS_SES_REGION=us-east-1

# ── Sender defaults ───────────────────────────────────────────────────────────
SENDER_FIRST_NAME=YourName
SENDER_CALENDAR_LINK=https://cal.com/yourname
COMPANY_SITE_URL=https://yourdomain.com/

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ── Database pool ─────────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

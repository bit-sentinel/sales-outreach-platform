# ==============================================================================
# OutreachAI – Environment Configuration Template
# Copy this file to .env and fill in values
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=OutreachAI
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://outreach:outreach_secret@localhost:5432/outreachai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (fallback LLM) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Web Research APIs ────────────────────────────────────────────────────────
SERPAPI_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=tvly-...

# ── Email – SendGrid ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=outreach@yourdomain.com

# ── Email – Amazon SES (alternative) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1

# ── Gmail OAuth (optional per-user) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS S3 (attachments, exports) ───────────────────────────────────────────
AWS_S3_BUCKET=outreachai-uploads
AWS_S3_REGION=us-east-1

# ── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=OutreachAI

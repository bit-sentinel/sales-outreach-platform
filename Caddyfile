# ──────────────────────────────────────────────────────────
# OutreachAI – Caddyfile
# Replace YOUR_DOMAIN with your actual domain, e.g. outreachai.com
# Caddy auto-provisions and renews TLS certificates via Let's Encrypt
# ──────────────────────────────────────────────────────────

# Disable Caddy admin API (never expose on production)
admin off

# Frontend — serves the Next.js app
# All /api/* requests are proxied to the backend by Next.js itself (see next.config.js rewrites)
YOUR_DOMAIN {
    reverse_proxy frontend:3000

    # Security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.anthropic.com; frame-ancestors 'none';"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Compress responses
    encode gzip
}

# Optional: redirect www → apex
www.YOUR_DOMAIN {
    redir https://YOUR_DOMAIN{uri} permanent
}
